int find_str (char * sub, char * str)
{
	int i = 0;
	int j = 0;

	while (str[j] != 0)
	{		
		i = 0;
		while (sub[i] != 0)
		{
			if (sub[i] != str[i+j])
			{
				break;
			}	
		i++;	
		}

		if (sub[i] == 0)
			return 0;

		j++;
		
	}

	return -1;
}


